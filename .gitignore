# ───────────────────────────────────────────
#  HoneyPot Network Security — .gitignore
# ───────────────────────────────────────────

# ── Documents & Presentations (do NOT push) ──
*.pptx
*.ppt
*.pptm
*.docx
*.doc
*.docm
*.xlsx
*.xls
*.xlsm
*.pdf

# Inspection temp folders created by doc tools
.docx_inspect/
.docx_inspect.zip

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtual environments
.venv/
.venv_local/
venv/
env/
ENV/

# Eggs / distributions
*.egg-info/
*.egg
dist/
build/

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
/coverage

# mypy
.mypy_cache/
.dmypy.json

# ── Trained ML Model files ──
# (generated by ml/train_model_multi.py — reproduce locally)
models/*.pkl
models/*.joblib

# ── Runtime data & logs ──
data/attack_logs.csv
data/attack_logs_filtered_ui.csv
data/*.lock
data/.honeypot_manager.lock
*.lock
logging/*.log
*.log

# ── Node / Frontend ──
node_modules/
Frontend/node_modules/

# Build outputs
/build
/out
/.next/
Frontend/dist/
Frontend/build/

# Yarn
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# npm debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ── Environment & Secrets ──
.env
.env.*
*.pem
*.key
*.cert

# OAuth / API credential files
google_tokens/
google_web_oauth_client.json
*.apps.googleusercontent.com.json

# ── IDE & OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Misc project temp files ──
prompt.md
links.txt
docs/

# Vercel
.vercel

# Windows PowerShell reset scripts (optional — remove if you want to keep)
# reset_venv.bat
